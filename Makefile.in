APP_NAME = $$APPNAME$$
FULL_APP_NAME = $$FULLAPPNAME$$
VERS = $$VERSION$$
PYEXEC = $$PYEXEC$$
PREFIX = $$PREFIX$$
FILE_PREFIX = $$FPREFIX$$

default: build

test:
	PYTHONPATH=src $(PYEXEC) -m unittest discover tests/utils/
	PYTHONPATH=src $(PYEXEC) -m unittest discover tests/tracking/
	PYTHONPATH=src $(PYEXEC) -m unittest discover tests/general/
	PYTHONPATH=src $(PYEXEC) -m unittest discover tests/analysis/
	PYTHONPATH=src $(PYEXEC) -m unittest discover tests/data/

build:
    $(PYEXEC) -m PyInstaller --noconfirm main.spec
    mkdir -p out
    mv dist/main/main dist/main/$(APP_NAME)
    mv dist/main/ dist/$(APP_NAME)/
    tar -czvf out/$(FILE_PREFIX)-linux.tar.gz dist/$(APP_NAME)/
    $$START_MACOS1$$
    mkdir dist/macos_out
    mv dist/main.app dist/macos_out/$(APP_NAME).app
    ln -s /Applications/ dist/macos_out/Applications
    hdiutil create -volname $(FULL_APP_NAME) -srcfolder dist/macos_out/ -ov -format UDZO out/$(FILE_PREFIX)-macos.dmg
    $$END_MACOS1$$

install: build
    mkdir -p $(PREFIX)
    mv dist/$(APP_NAME)/* $(PREFIX)/
    if [ -d "/usr/share/applications" ]; then \
		touch /usr/share/applications/$(APPNAME).desktop; \
		echo "[Desktop Entry]\n" >> /usr/share/applications/$(APPNAME).desktop; \
		echo "Type=Application\n" >> /usr/share/applications/$(APPNAME).desktop; \
		echo "Version=$(VERS)\n" >> /usr/share/applications/$(APPNAME).desktop; \
		echo "Name=$(APPNAME)\n" >> /usr/share/applications/$(APPNAME).desktop; \
		echo "Path=$(PREFIX)\n" >> /usr/share/applications/$(APPNAME).desktop; \
		echo "Exec=$(APPNAME)\n" >> /usr/share/applications/$(APPNAME).desktop; \
		echo "Icon=$(PREFIX)/icons/icon.png\n" >> /usr/share/applications/$(APPNAME).desktop; \
	fi

deb:
    mkdir -p dist/$(APPNAME)_$(APPVERSION)/opt/$(APPNAME)
    cp dist/$(APPNAME)/* dist/$(APPNAME)_$(APPVERSION)/opt/$(APPNAME)/*
    mkdir -p dist/$(APPNAME)_$(APPVERSION)/usr/share/applications
    touch dist/$(APPNAME)_$(APPVERSION)/usr/share/applications/$(APPNAME).desktop
    echo "[Desktop Entry]\n" >> dist/$(APPNAME)_$(APPVERSION)/usr/share/applications/$(APPNAME).desktop
    echo "Type=Application\n" >> dist/$(APPNAME)_$(APPVERSION)/usr/share/applications/$(APPNAME).desktop
    echo "Version=$(VERS)\n" >> dist/$(APPNAME)_$(APPVERSION)/usr/share/applications/$(APPNAME).desktop
    echo "Name=$(APPNAME)\n" >> dist/$(APPNAME)_$(APPVERSION)/usr/share/applications/$(APPNAME).desktop
    echo "Path=/opt/$(APPNAME)\n" >> dist/$(APPNAME)_$(APPVERSION)/usr/share/applications/$(APPNAME).desktop
    echo "Exec=$(APPNAME)\n" >> dist/$(APPNAME)_$(APPVERSION)/usr/share/applications/$(APPNAME).desktop
    echo "Icon=$/opt/(APPNAME)/icons/icon.png\n" >> dist/$(APPNAME)_$(APPVERSION)/usr/share/applications/$(APPNAME).desktop
    mkdir -p dist/$(APPNAME)_$(APPVERSION)/DEBIAN
    touch dist/$(APPNAME)_$(APPVERSION)/DEBIAN/control
    echo "Package: $(APPNAME)" >> dist/$(APPNAME)_$(APPVERSION)/DEBIAN/control
    echo "Version: $(VER)" >> dist/$(APPNAME)_$(APPVERSION)/DEBIAN/control
    echo "Section: base" >> dist/$(APPNAME)_$(APPVERSION)/DEBIAN/control
    echo "Priority: optional" >> dist/$(APPNAME)_$(APPVERSION)/DEBIAN/control
    echo "Architecture: amd64" >> dist/$(APPNAME)_$(APPVERSION)/DEBIAN/control
    echo "Depends: " >> dist/$(APPNAME)_$(APPVERSION)/DEBIAN/control
    echo "Maintainer: Nikita Serba <nikitaserba@icloud.com>" >> dist/$(APPNAME)_$(APPVERSION)/DEBIAN/control
    dpkg-deb --build dist/$(APPNAME)_$(APPVERSION)/
    # TODO: rename

rpm: deb
    fakeroot talien --to-rpm out/$(FILE_PREFIX)-linux_amd64.deb

clean:
    rm -rf ./build/
    rm -rf ./dist/
    rm -rf ./out/

dist-clean: clean
    rm -f requirements.tmp
    rm -f Makefile
